# ── Wajib ────────────────────────────────────────────────────────────────
# Server menolak start bila dua nilai ini kosong.

# Koneksi PostgreSQL
DATABASE_URL=host=localhost user=postgres password=1234lima dbname=openjek port=5432 sslmode=disable TimeZone=Asia/Jakarta

# Kunci penandatangan JWT. Minimal 32 karakter acak.
# Buat dengan: openssl rand -hex 32
JWT_SECRET=7edd09ccc92da81a574f292e4453717f8f33d3c61a320deb4e9d6d6fbc5e1695

# ── Opsional ─────────────────────────────────────────────────────────────
PORT=8080
REDIS_URL=localhost:6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Origin yang boleh membuka koneksi WebSocket, dipisah koma.
# Mencakup domain admin produksi dan port development localhost.
ALLOWED_WS_ORIGINS=https://umfa.fazalabs.sbs,http://umfa.fazalabs.sbs,https://umfa-core.fazalabs.sbs,http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# ── Midtrans ─────────────────────────────────────────────────────────────
# Bila MIDTRANS_SERVER_KEY kosong dan MIDTRANS_IS_PRODUCTION=false,
# top up berjalan dalam mode simulasi tanpa pembayaran nyata.
# MIDTRANS_SERVER_KEY wajib diisi saat MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Testing ──────────────────────────────────────────────────────────────
# Dipakai oleh test integrasi di internal/handlers.
# Bila kosong, test tersebut di-skip.
TEST_DATABASE_URL=host=localhost user=postgres password=1234lima dbname=ojek_test port=5432 sslmode=disable TimeZone=Asia/Jakarta

ADMIN_EMAIL=admin@openjek.id
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Super Admin
DEMO_PASSWORD=password123

