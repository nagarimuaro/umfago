# ── UmfaGo Admin Frontend Environment Configuration ───────────────────
# Untuk build produksi yang memanggil API langsung:
# VITE_API_BASE_URL=https://umfa-core.fazalabs.sbs
#
# Bila dikosongkan, dashboard akan menggunakan relative path (/api/...)
# yang secara otomatis di-proxy oleh Nginx di domain https://umfa.fazalabs.sbs.
VITE_API_BASE_URL=

# Untuk pengembangan lokal via Vite dev server:
VITE_BACKEND_URL=http://localhost:8080
